# ==========================================
# Splitwise Cloud Edge 开发隔离配置
# 说明：
# 1. 这份配置用于本地开发 / 自联调，避免影响当前真实运行中的系统
# 2. 当前真实系统默认使用 backend/.env
# 3. 如需启用这份配置，请在启动前手动切换到 .env.dev
# ==========================================

# 服务器运行配置（与真实运行端口 8010 错开）
SERVER_HOST=0.0.0.0
SERVER_PORT=8110
SERVER_PUBLIC_BASE_URL=http://127.0.0.1:8110

# 初始化管理员账号配置
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 云端后端自己的 JWT 密钥
SECRET_KEY=dev-backend-secret-key

# OpenWebUI Token Exchange 配置
# 开发联调默认跳过真实验签，避免影响线上真实系统
OPENWEBUI_SKIP_SIGNATURE_VERIFY=true
OPENWEBUI_JWT_SECRET=replace-if-needed-for-real-openwebui-dev

BACKEND_BASE_URL=http://127.0.0.1:8110
SQLITE_DB_PATH=data/cloud_edge_dev.db
RUNTIME_CONTROL_PATH=/load_strategy

# ==========================================
# 联调模式切换（开发默认全 mock）
# ==========================================

EDGE_FRONTEND_USE_MOCK=true
EDGE_FRONTEND_MOCK_MODEL_TYPE=Llama-3.2-3b
EDGE_DEVICE_IP=10.144.144.3

EDGE_RUNTIME_USE_MOCK=true
CLOUD_RUNTIME_USE_MOCK=true

# 真实模型推理服务目标
# 仅当把上面两个 *_USE_MOCK 改为 false 时才会生效
EDGE_RUNTIME_REAL_HOST=
CLOUD_RUNTIME_REAL_HOST=10.144.144.2
EDGE_RUNTIME_REAL_PORT=9001
CLOUD_RUNTIME_REAL_PORT=9002

# 本地 mock 模型推理服务目标（与真实系统 mock 端口错开）
EDGE_RUNTIME_MOCK_HOST=127.0.0.1
CLOUD_RUNTIME_MOCK_HOST=127.0.0.1
EDGE_RUNTIME_MOCK_PORT=18101
CLOUD_RUNTIME_MOCK_PORT=18102

MODEL_STARTUP_RESOURCE_CHECK_ENABLED=true
MODEL_STARTUP_MAX_MEMORY_PERCENT=95

# 算法切分服务配置
# 开发默认使用 mock，并把 mock 端口与常用值错开，避免误碰
ALGORITHM_USE_MOCK=true
ALGORITHM_REAL_API_URL=http://127.0.0.1:8050/infer
ALGORITHM_MOCK_API_URL=http://127.0.0.1:15100/infer
ALGORITHM_API_TIMEOUT_SECONDS=10

# 网络状态采集配置
NETWORK_PING_COUNT=4
NETWORK_PING_TIMEOUT_SECONDS=1.0

# 开发自联调可按需关闭 iperf3，避免影响真实链路
NETWORK_ENABLE_IPERF3=false
NETWORK_IPERF3_PORT=5201
NETWORK_IPERF3_DURATION_SECONDS=1
NETWORK_IPERF3_TIMEOUT_SECONDS=6

NETWORK_DEFAULT_EDGE_RTT_MS=0.27
NETWORK_DEFAULT_CLOUD_RTT_MS=0.02
NETWORK_DEFAULT_BANDWIDTH_MBPS=1000.0
NETWORK_DEFAULT_PACKET_LOSS=0.0
