# ==========================================
# Splitwise Cloud Edge 正式试运行配置
# 说明：
# 1. 这份配置用于 /home/nss-d/wyy/splitwise_cloud_dev 的正式试运行
# 2. 保持与 ModelSplit/.env.prod 的边端前端和基础推理端口对齐
# 3. backend 使用 8010，对接边端正式 SCHEDULE_BACKEND_URL
# 4. 动态 cloud slot 池使用独立端口段，避免与 9000~9003 冲突
# ==========================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8010
SERVER_PUBLIC_BASE_URL=http://10.144.144.4:8010
BACKEND_BASE_URL=http://10.144.144.4:8010

ADMIN_USERNAME=
ADMIN_PASSWORD=

SECRET_KEY=wyy-prod-backend-secret-key

OPENWEBUI_SKIP_SIGNATURE_VERIFY=true
OPENWEBUI_JWT_SECRET=replace-if-needed-for-real-openwebui-prod

SQLITE_DB_PATH=data/cloud_edge_prod.db
RUNTIME_CONTROL_PATH=/load_strategy

EDGE_FRONTEND_USE_MOCK=false
EDGE_FRONTEND_MOCK_MODEL_TYPE=Llama-3.2-3b
EDGE_DEVICE_IP=10.144.144.4

EDGE_RUNTIME_USE_MOCK=false
CLOUD_RUNTIME_USE_MOCK=false

EDGE_RUNTIME_REAL_HOST=
CLOUD_RUNTIME_REAL_HOST=10.144.144.4
EDGE_RUNTIME_REAL_PORT=9001
CLOUD_RUNTIME_REAL_PORT=9002

EDGE_RUNTIME_MOCK_HOST=127.0.0.1
CLOUD_RUNTIME_MOCK_HOST=127.0.0.1
EDGE_RUNTIME_MOCK_PORT=19001
CLOUD_RUNTIME_MOCK_PORT=19002

MODEL_STARTUP_RESOURCE_CHECK_ENABLED=true
MODEL_STARTUP_MAX_MEMORY_PERCENT=95

ALGORITHM_USE_MOCK=false
ALGORITHM_REAL_API_URL=http://127.0.0.1:8050/infer
ALGORITHM_MOCK_API_URL=http://127.0.0.1:15120/infer
ALGORITHM_API_TIMEOUT_SECONDS=10

NETWORK_PING_COUNT=4
NETWORK_PING_TIMEOUT_SECONDS=1.0

NETWORK_ENABLE_IPERF3=false
NETWORK_IPERF3_PORT=5201
NETWORK_IPERF3_DURATION_SECONDS=1
NETWORK_IPERF3_TIMEOUT_SECONDS=6

NETWORK_DEFAULT_EDGE_RTT_MS=0.27
NETWORK_DEFAULT_CLOUD_RTT_MS=0.02
NETWORK_DEFAULT_BANDWIDTH_MBPS=1000.0
NETWORK_DEFAULT_PACKET_LOSS=0.0

RUNTIME_INTEGRITY_TOKEN=wyy-local-aloepri-integrity
MODELSPLIT_DEV_ROOT=/home/wyy/workspace/ModelSplit
MODELSPLIT_PYTHON_BIN=/home/miniconda3/envs/modelsplit/bin/python
ASCEND_ENV_SCRIPT=/usr/local/Ascend/ascend-toolkit/set_env.sh

# 动态 cloud slot 池独立端口，避免与 9000~9003 的固定前端/基础服务端口冲突
CLOUD_SLOT_HTTP_BASE_PORT=9020
CLOUD_SLOT_GRPC_BASE_PORT=51200
CLOUD_SLOT_MAX_COUNT=2

RUNTIME_CONFIRMATION_PATH=/api/v1/schedule/runtime/confirmation/cloud
# CLOUD_RUNTIME_REAL_GRPC_TARGET=10.144.144.4:51052
CLOUD_SLOT_PROCESS_IDLE_TIMEOUT_SECONDS=300

ASCEND_IPS=10.144.144.4
ASCEND_NPU_EXPORTER_PORT=9500

PROMETHEUS_URL=http://127.0.0.1:9091
MODEL_DEVICE=npu:0
MODEL_REGISTRY_PATH=/home/wyy/workspace/ModelSplit/configs/model_registry.json
PARTITION_CONFIG_PATH=/home/wyy/workspace/ModelSplit/configs/llama_3b_instruct_layer_wise.json
ALOEPRI_SERVER_DIR=/home/wyy/models/aloepri/Llama-3.2-3B-Instruct/server
ALOEPRI_CLIENT_SECRET=/home/wyy/models/aloepri/Llama-3.2-3B-Instruct/client/client_secret.pt
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
NO_PROXY=127.0.0.1,localhost,10.144.144.4,10.144.144.5,10.144.144.0/24
no_proxy=127.0.0.1,localhost,10.144.144.4,10.144.144.5,10.144.144.0/24
MODEL_NAME=Llama-3.2-3B-Instruct
CLOUD_SLOT_NPU_DEVICES=0,1
CLOUD_SLOT_ALLOW_NPU_OVERSUBSCRIPTION=false
