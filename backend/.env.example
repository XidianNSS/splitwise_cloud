# ==========================================
# Splitwise Cloud backend environment template
# Copy this file to backend/.env.prod or set BACKEND_ENV_FILE to point at it.
# ==========================================

# Backend service binding.
SERVER_HOST=0.0.0.0
SERVER_PORT=8010
SERVER_PUBLIC_BASE_URL=http://CLOUD_IP:8010
BACKEND_BASE_URL=http://CLOUD_IP:8010

# Optional bootstrap admin account.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Backend JWT / OpenWebUI token verification.
SECRET_KEY=replace-with-backend-secret-key
OPENWEBUI_SKIP_SIGNATURE_VERIFY=false
OPENWEBUI_JWT_SECRET=replace-with-openwebui-jwt-secret
OPENWEBUI_JWT_ALGORITHM=HS256
OPENWEBUI_USERNAME_CLAIMS=sub,username,email,name,preferred_username
OPENWEBUI_ROLE_CLAIMS=role,groups
OPENWEBUI_EXPECTED_ISSUER=
OPENWEBUI_EXPECTED_AUDIENCE=

# Storage.
SQLITE_DB_PATH=data/cloud_edge_prod.db

# Runtime control API path used by ModelSplit runtimes.
RUNTIME_CONTROL_PATH=/load_strategy
RUNTIME_CONFIRMATION_PATH=/api/v1/schedule/runtime/confirmation/cloud
RUNTIME_CONFIRMATION_FORWARD_TIMEOUT_SECONDS=30
RUNTIME_INTEGRITY_TOKEN=replace-with-shared-integrity-token

# ==========================================
# Frontend / edge runtime integration
# ==========================================
# Set EDGE_FRONTEND_USE_MOCK=true only for local/mock frontend testing.
EDGE_FRONTEND_USE_MOCK=false
EDGE_FRONTEND_MOCK_MODEL_TYPE=Llama-3.2-3B-Instruct
EDGE_DEVICE_IP=EDGE_IP

EDGE_RUNTIME_USE_MOCK=false
CLOUD_RUNTIME_USE_MOCK=false

# Edge runtime host is usually inferred from /session/init edge_device_ip.
EDGE_RUNTIME_REAL_HOST=
EDGE_RUNTIME_REAL_PORT=9001
CLOUD_RUNTIME_REAL_HOST=CLOUD_IP
CLOUD_RUNTIME_REAL_PORT=9002
CLOUD_RUNTIME_REAL_GRPC_TARGET=

EDGE_RUNTIME_MOCK_HOST=127.0.0.1
EDGE_RUNTIME_MOCK_PORT=19001
CLOUD_RUNTIME_MOCK_HOST=127.0.0.1
CLOUD_RUNTIME_MOCK_PORT=19002

# Startup guardrails.
MODEL_STARTUP_RESOURCE_CHECK_ENABLED=true
MODEL_STARTUP_MAX_MEMORY_PERCENT=95

# ==========================================
# Algorithm service
# ==========================================
# In production, keep ALGORITHM_USE_MOCK=false and point ALGORITHM_REAL_API_URL
# to the real algorithm service. For tests, start tests/mock_algorithm_server.py
# with ALGORITHM_USE_MOCK=true and ALGORITHM_MOCK_PORT matching the URL below.
ALGORITHM_USE_MOCK=false
ALGORITHM_REAL_API_URL=http://127.0.0.1:8050/infer
ALGORITHM_MOCK_API_URL=http://127.0.0.1:8050/infer
ALGORITHM_API_TIMEOUT_SECONDS=10

# ==========================================
# Network probing
# ==========================================
NETWORK_PING_COUNT=4
NETWORK_PING_TIMEOUT_SECONDS=1.0
NETWORK_ENABLE_IPERF3=false
NETWORK_IPERF3_PORT=5201
NETWORK_IPERF3_DURATION_SECONDS=1
NETWORK_IPERF3_TIMEOUT_SECONDS=6
NETWORK_DEFAULT_EDGE_RTT_MS=1.0
NETWORK_DEFAULT_CLOUD_RTT_MS=1.0
NETWORK_DEFAULT_BANDWIDTH_MBPS=1000.0
NETWORK_DEFAULT_PACKET_LOSS=0.0
NETWORK_PROBE_CACHE_SECONDS=30
NETWORK_MAX_CONCURRENT_PROBES=5

# ==========================================
# Prometheus / accelerator metrics
# ==========================================
PROMETHEUS_URL=http://127.0.0.1:9091
PROMETHEUS_QUERY_TIMEOUT=3
PROMETHEUS_CACHE_SECONDS=15

# The backend selects Prometheus query templates by IP:
# - IPs listed in ASCEND_IPS use Ascend NPU metrics.
# - Other IPs use NVIDIA DCGM GPU metrics.
ASCEND_IPS=ASCEND_DEVICE_IP_LIST
ASCEND_NPU_EXPORTER_PORT=9500

# ==========================================
# Managed ModelSplit cloud decode slot pool
# ==========================================
MODELSPLIT_DEV_ROOT=/path/to/ModelSplit
MODELSPLIT_PYTHON_BIN=/path/to/conda/env/bin/python

# Ascend deployments usually need this toolkit script.
# For NVIDIA/CUDA-only deployments, leave it empty to skip sourcing Ascend env.
ASCEND_ENV_SCRIPT=/usr/local/Ascend/ascend-toolkit/set_env.sh

CLOUD_SLOT_HTTP_BASE_PORT=9020
CLOUD_SLOT_GRPC_BASE_PORT=51200
CLOUD_SLOT_MAX_COUNT=2
CLOUD_SLOT_PROCESS_IDLE_TIMEOUT_SECONDS=300
RUNTIME_SLOT_RECONCILE_INTERVAL_SECONDS=5

# Device assignment for managed cloud slots.
# Ascend examples: CLOUD_SLOT_NPU_DEVICES=0,1 or npu:0,npu:1
# NVIDIA examples: CLOUD_SLOT_NPU_DEVICES=cuda:0,cuda:1
# If empty, MODEL_DEVICE is used for all managed slots.
CLOUD_SLOT_NPU_DEVICES=0,1
CLOUD_SLOT_ALLOW_NPU_OVERSUBSCRIPTION=false

# Fallback device passed to managed ModelSplit decode runtimes when
# CLOUD_SLOT_NPU_DEVICES is empty.
# Use cuda:0 for NVIDIA, npu:0 for Ascend, or cpu for CPU-only smoke tests.
MODEL_DEVICE=npu:0

# ==========================================
# ModelSplit runtime configuration inherited by managed cloud slots
# ==========================================
MODEL_NAME=Llama-3.2-3B-Instruct
MODEL_REGISTRY_PATH=/path/to/ModelSplit/configs/model_registry.json
PARTITION_CONFIG_PATH=/path/to/ModelSplit/configs/llama_3b_instruct_layer_wise.json
ALOEPRI_SERVER_DIR=/path/to/aloepri/Llama-3.2-3B-Instruct/server
ALOEPRI_CLIENT_SECRET=/path/to/aloepri/Llama-3.2-3B-Instruct/client/client_secret.pt
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# Keep internal service calls off external proxies.
NO_PROXY=127.0.0.1,localhost,CLOUD_IP,EDGE_IP_LIST,CLUSTER_CIDR
no_proxy=127.0.0.1,localhost,CLOUD_IP,EDGE_IP_LIST,CLUSTER_CIDR
