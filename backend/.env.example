# ==========================================
# Splitwise Cloud Edge 核心配置文件（示例）
# ==========================================

# 服务器运行配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8010
SERVER_PUBLIC_BASE_URL=http://127.0.0.1:8010

# 初始化管理员账号配置
# 仅在数据库里还没有管理员账号时生效。
# 留空时回退到默认值：admin / admin123
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 云端后端自己的 JWT 密钥
# 用途：
# 1. /api/v1/login 登录成功后，给前端签发本系统 access_token
# 2. 本系统管理员态受保护接口（如登录后访问的管理接口）
#    使用这个密钥来验证“云端后端自己签发的业务 token”
# 注意：这不是 OpenWebUI 的签名密钥，不能拿它去验证 OpenWebUI token
SECRET_KEY=replace-with-your-backend-secret-key

# OpenWebUI Token Exchange 配置
# 是否跳过 OpenWebUI token 验签
# 开发联调阶段先设为 true；拿到真实 OpenWebUI 密钥后改成 false
OPENWEBUI_SKIP_SIGNATURE_VERIFY=false

# OpenWebUI 实例真正用于签发 JWT 的密钥
# 仅当 OPENWEBUI_SKIP_SIGNATURE_VERIFY=false 时才需要填写
# 这个值应该来自 OpenWebUI 的部署配置（例如 WEBUI_SECRET_KEY）
# 注意：这不是你当前后端自己的 SECRET_KEY
OPENWEBUI_JWT_SECRET=replace-with-your-openwebui-jwt-secret

BACKEND_BASE_URL=http://127.0.0.1:8010
SQLITE_DB_PATH=data/cloud_edge.db
RUNTIME_CONTROL_PATH=/load_strategy

# ==========================================
# 联调模式切换
# ==========================================

# 边端前端是“入站调用者”，云端后端不会主动连接它。
# 因此这里的开关主要用于你是否要运行 tests/mock_edge_client.py。
EDGE_FRONTEND_USE_MOCK=false
EDGE_FRONTEND_MOCK_MODEL_TYPE=Llama-3.2-3b
EDGE_DEVICE_IP=10.144.144.3

# 模型推理服务控制端口切换：
# true  = 云端后端把策略下发到本机 mock 模型推理服务
# false = 云端后端把策略下发到真实边/云设备上的模型推理服务固定控制端口
EDGE_RUNTIME_USE_MOCK=false
CLOUD_RUNTIME_USE_MOCK=false

# 真实模型推理服务目标
# edge 真实 host 默认仍可由 session/init 传入的 edge_device_ip 决定；
# 如果后续某一环境需要强制指定，也可以在这里写死。
EDGE_RUNTIME_REAL_HOST=
CLOUD_RUNTIME_REAL_HOST=10.144.144.2
EDGE_RUNTIME_REAL_PORT=9001
CLOUD_RUNTIME_REAL_PORT=9002

# 本地 mock 模型推理服务目标
EDGE_RUNTIME_MOCK_HOST=127.0.0.1
CLOUD_RUNTIME_MOCK_HOST=127.0.0.1
EDGE_RUNTIME_MOCK_PORT=18001
CLOUD_RUNTIME_MOCK_PORT=18002

MODEL_STARTUP_RESOURCE_CHECK_ENABLED=true
MODEL_STARTUP_MAX_MEMORY_PERCENT=95

# 算法切分服务配置
# 自我联调时可开启 mock；关闭后请求会直接发往真实算法服务。
ALGORITHM_USE_MOCK=false
ALGORITHM_REAL_API_URL=http://127.0.0.1:8050/infer
ALGORITHM_MOCK_API_URL=http://127.0.0.1:5100/infer
ALGORITHM_API_TIMEOUT_SECONDS=10

# 网络状态采集配置
# RTT / 丢包使用系统 ping 探测；若探测失败，则回退到下面这些默认值。
NETWORK_PING_COUNT=4
NETWORK_PING_TIMEOUT_SECONDS=1.0

# 真实带宽探测配置
# 当前启用 iperf3 双向探测，并取双向结果中的较小值作为有效带宽。
# 请保证本机已安装 iperf3，且 edge 端运行了 iperf3 server。
NETWORK_ENABLE_IPERF3=true
NETWORK_IPERF3_PORT=5201
NETWORK_IPERF3_DURATION_SECONDS=1
NETWORK_IPERF3_TIMEOUT_SECONDS=6

# 当前根据本机实际探测结果设置的默认回退值。
NETWORK_DEFAULT_EDGE_RTT_MS=0.27
NETWORK_DEFAULT_CLOUD_RTT_MS=0.02
NETWORK_DEFAULT_BANDWIDTH_MBPS=1000.0
NETWORK_DEFAULT_PACKET_LOSS=0.0
