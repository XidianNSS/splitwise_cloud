# ==========================================
# Splitwise Cloud Edge WYY 开发隔离配置
# 说明：
# 1. 这份配置用于 /home/nss-d/wyy/splitwise_cloud_dev worktree 的并发控制开发
# 2. 端口、数据库与正式版隔离，避免影响当前正在运行的 prod 服务
# 3. 如需启用：
#    BACKEND_ENV_FILE=backend/.env.wyy bash scripts/run_server.sh
# ==========================================

# 服务器运行配置（避开正式版 8010 和当前已使用的 9121）
SERVER_HOST=0.0.0.0
SERVER_PORT=18123
SERVER_PUBLIC_BASE_URL=http://10.144.144.2:18123
BACKEND_BASE_URL=http://10.144.144.2:18123

# 初始化管理员账号配置
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 云端后端自己的 JWT 密钥（开发专用）
SECRET_KEY=wyy-dev-backend-secret-key

# OpenWebUI Token Exchange 配置
# 开发联调默认跳过真实验签，避免影响线上真实系统
OPENWEBUI_SKIP_SIGNATURE_VERIFY=true
OPENWEBUI_JWT_SECRET=replace-if-needed-for-real-openwebui-dev

# 开发版独立数据库，避免污染正式版数据
SQLITE_DB_PATH=data/cloud_edge_wyy.db
RUNTIME_CONTROL_PATH=/load_strategy

# ==========================================
# 联调模式切换（默认接入 WYY 开发 runtime，而非 prod）
# ==========================================
EDGE_FRONTEND_USE_MOCK=false
EDGE_FRONTEND_MOCK_MODEL_TYPE=Llama-3.2-3b
EDGE_DEVICE_IP=127.0.0.1

EDGE_RUNTIME_USE_MOCK=false
CLOUD_RUNTIME_USE_MOCK=false

# 指向当前 WYY 开发版 ModelSplit runtime 端口
# edge host 默认仍由 session/init 传入的 edge_device_ip 决定
EDGE_RUNTIME_REAL_HOST=
CLOUD_RUNTIME_REAL_HOST=127.0.0.1
EDGE_RUNTIME_REAL_PORT=19112
CLOUD_RUNTIME_REAL_PORT=19114

# 预留的 mock runtime 端口（避开常用开发端口）
EDGE_RUNTIME_MOCK_HOST=127.0.0.1
CLOUD_RUNTIME_MOCK_HOST=127.0.0.1
EDGE_RUNTIME_MOCK_PORT=19112
CLOUD_RUNTIME_MOCK_PORT=19113

MODEL_STARTUP_RESOURCE_CHECK_ENABLED=true
MODEL_STARTUP_MAX_MEMORY_PERCENT=95

# 算法切分服务配置
# 当前默认仍走本机真实算法服务；如果后续需要 mock 可单独切换
ALGORITHM_USE_MOCK=false
ALGORITHM_REAL_API_URL=http://127.0.0.1:8050/infer
ALGORITHM_MOCK_API_URL=http://127.0.0.1:15120/infer
ALGORITHM_API_TIMEOUT_SECONDS=10

# 网络状态采集配置
NETWORK_PING_COUNT=4
NETWORK_PING_TIMEOUT_SECONDS=1.0

# 开发阶段默认关闭 iperf3，避免影响现网链路
NETWORK_ENABLE_IPERF3=false
NETWORK_IPERF3_PORT=5201
NETWORK_IPERF3_DURATION_SECONDS=1
NETWORK_IPERF3_TIMEOUT_SECONDS=6

NETWORK_DEFAULT_EDGE_RTT_MS=0.27
NETWORK_DEFAULT_CLOUD_RTT_MS=0.02
NETWORK_DEFAULT_BANDWIDTH_MBPS=1000.0
NETWORK_DEFAULT_PACKET_LOSS=0.0
RUNTIME_INTEGRITY_TOKEN=wyy-local-aloepri-integrity
MODELSPLIT_DEV_ROOT=/home/nss-d/wyy/ModelSplit_dev
CLOUD_SLOT_HTTP_BASE_PORT=19113
CLOUD_SLOT_GRPC_BASE_PORT=52163
CLOUD_SLOT_MAX_COUNT=4
RUNTIME_CONFIRMATION_PATH=/api/v1/schedule/runtime/confirmation/cloud
CLOUD_RUNTIME_REAL_GRPC_TARGET=127.0.0.1:52164
CLOUD_SLOT_PROCESS_IDLE_TIMEOUT_SECONDS=5
